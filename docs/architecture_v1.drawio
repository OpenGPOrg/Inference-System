<mxfile host="app.diagrams.net" modified="2026-11-20T09:48:00.000Z" agent="OpenGP Engine" version="21.0.0" type="device">
  <diagram id="opengp-layer-streaming-arch" name="OpenGP 3-Tier Layer Streaming Architecture">
    <mxGraphModel dx="1420" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- TIER 1 CONTAINER -->
        <mxCell id="tier1_box" value="TIER 1: PERSISTENT STORAGE (SSD / NVMe DISK)&#xa;Full GGUF Model Repository" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;fontStyle=1;fontSize=14;startSize=30;" vertex="1" parent="1">
          <mxGeometry x="60" y="40" width="1080" height="130" as="geometry" />
        </mxCell>
        <mxCell id="t1_embed" value="token_embd.weight&#xa;[32000, d_model]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="tier1_box">
          <mxGeometry x="30" y="45" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="t1_layer0" value="blk.0 Weights&#xa;(q, k, v, out, ffn)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="tier1_box">
          <mxGeometry x="200" y="45" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="t1_layer1" value="blk.1 Weights&#xa;(q, k, v, out, ffn)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="tier1_box">
          <mxGeometry x="370" y="45" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="t1_dots" value="... blk.2 to blk.N-2 ..." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=2;" vertex="1" parent="tier1_box">
          <mxGeometry x="540" y="60" width="160" height="30" as="geometry" />
        </mxCell>
        <mxCell id="t1_layerN" value="blk.N-1 Weights&#xa;(q, k, v, out, ffn)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="tier1_box">
          <mxGeometry x="730" y="45" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="t1_output" value="output.weight &amp; Norm&#xa;[d_model, 32000]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="tier1_box">
          <mxGeometry x="900" y="45" width="150" height="60" as="geometry" />
        </mxCell>

        <!-- TIER 2 CONTAINER -->
        <mxCell id="tier2_box" value="TIER 2: HOST SYSTEM RAM&#xa;Double-Buffered Staging Arena &amp; KV Cache Storage" style="swimlane;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=14;startSize=30;" vertex="1" parent="1">
          <mxGeometry x="60" y="240" width="1080" height="180" as="geometry" />
        </mxCell>
        <mxCell id="t2_slotA" value="Host Pinned Staging: Slot A&#xa;[blk.i Layer Weights]&#xa;Status: Ready / DMA Transferring" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;" vertex="1" parent="tier2_box">
          <mxGeometry x="50" y="50" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="t2_slotB" value="Host Pinned Staging: Slot B&#xa;[blk.i+1 Layer Weights]&#xa;Status: Async Prefetch from Disk" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;" vertex="1" parent="tier2_box">
          <mxGeometry x="320" y="50" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="t2_coordinator" value="Model Orchestrator&#xa;&amp; GGUF Offset Directory&#xa;(Metadata, Tokenizer, Sequence Queue)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="tier2_box">
          <mxGeometry x="590" y="50" width="210" height="90" as="geometry" />
        </mxCell>
        <mxCell id="t2_kv_reservoir" value="Host KV-Cache Reservoir&#xa;Optional Spillover for ultra-low VRAM&#xa;[Layer 0..N-1 Keys &amp; Values]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="tier2_box">
          <mxGeometry x="840" y="50" width="210" height="90" as="geometry" />
        </mxCell>

        <!-- TIER 3 CONTAINER -->
        <mxCell id="tier3_box" value="TIER 3: DEVICE GPU VRAM (EXECUTION CORE)&#xa;Active Layer Compute &amp; In-Flight State" style="swimlane;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=14;startSize=30;" vertex="1" parent="1">
          <mxGeometry x="60" y="490" width="1080" height="240" as="geometry" />
        </mxCell>
        <mxCell id="t3_vram_weights" value="Active Layer Weight Slab (VRAM)&#xa;[blk.i Weights in FP16 / Q4_K]&#xa;(Instantly overwritten by blk.i+1 next cycle)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="tier3_box">
          <mxGeometry x="50" y="55" width="260" height="145" as="geometry" />
        </mxCell>
        <mxCell id="t3_vram_act" value="In-Flight Activation Vector&#xa;h_in -&gt; [Attention + MLP] -&gt; h_out&#xa;PERSISTS IN VRAM ACROSS LAYERS!&#xa;Shape: [Batch, Seq, d_model]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="tier3_box">
          <mxGeometry x="340" y="55" width="240" height="145" as="geometry" />
        </mxCell>
        <mxCell id="t3_vram_scratch" value="Transient Computation Workspace&#xa;(Allocated via ggml_gallocr)&#xa;- RoPE Output&#xa;- Q*K Attention Matrix &amp; Softmax&#xa;- FFN Gate * Up Products" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="tier3_box">
          <mxGeometry x="610" y="55" width="230" height="145" as="geometry" />
        </mxCell>
        <mxCell id="t3_vram_kv" value="Active Layer KV Slice&#xa;Keys &amp; Values for blk.i&#xa;(Swapped or kept resident)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="tier3_box">
          <mxGeometry x="870" y="55" width="180" height="145" as="geometry" />
        </mxCell>

        <!-- CONNECTORS / DATA FLOW -->
        <mxCell id="flow_disk_to_host" value="1. Async Disk Stream (pread / io_uring / mmap)&#xa;[Targeted file offset seek to blk.i+1]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeWidth=3;strokeColor=#d79b00;" edge="1" parent="1" source="t1_layer1" target="t2_slotB">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="flow_host_to_gpu" value="2. Pinned DMA Async Upload&#xa;(cudaMemcpyAsync / hipMemcpyAsync)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeWidth=3;strokeColor=#82b366;" edge="1" parent="1" source="t2_slotA" target="t3_vram_weights">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="flow_act_loop" value="3. Activation Loop:&#xa;h_out of blk.i becomes h_in of blk.i+1&#xa;NO DISK I/O!" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;strokeColor=#0050ef;curved=1;" edge="1" parent="tier3_box" source="t3_vram_act" target="t3_vram_act">
          <mxGeometry x="0.2" y="30" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="490" y="210" />
              <mxPoint x="430" y="210" />
            </Array>
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>

        <mxCell id="flow_kv_sync" value="Optional KV Swap" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=1;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#b85450;dashed=1;" edge="1" parent="1" source="t3_vram_kv" target="t2_kv_reservoir">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
